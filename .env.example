# Environment Configuration for Integration Tests

# Copy this file to .env and fill in your Opayo test account credentials
# This file should NOT be committed to version control

# Opayo Pi Test Account Credentials
# Get these from: https://sandbox.opayo.eu.elavon.com/mysagepay/ (test MySagePay portal)
OPAYO_VENDOR_NAME=
OPAYO_INTEGRATION_KEY=
OPAYO_INTEGRATION_PASSWORD=

# Test environment (test or live - should be 'test' for development)
OPAYO_ENVIRONMENT=test

# Optional: Specific card identifiers for testing
OPAYO_TEST_CARD_IDENTIFIER=

# Optional: Google Pay (demo/index.php?googlepay=1)
# The gatewayMerchantId Opayo issues when the wallet is enabled on your vendor
# (MyOpayo > Settings > Pay Methods > Google Pay). Quoted back to Opayo by the
# Google Pay sheet; an identifier, not a secret. Defaults to the vendor name.
OPAYO_GOOGLE_PAY_MERCHANT_ID=

# Your Google merchant ID from the Google Pay & Wallet Console - the same one
# Opayo asked for when enabling the wallet. Only read when the sheet runs in
# PRODUCTION, which is the only environment that mints a decryptable token.
GOOGLE_PAY_MERCHANT_ID=

# Which methods the demo offers (demo/index.php). All on by default; set any to
# 0 to hide that panel while you work on the others. DEMO_, not OPAYO_: this is
# about the demo page, not whether Opayo has the wallet enabled on your vendor.
DEMO_ENABLE_CARD=1
DEMO_ENABLE_GOOGLE_PAY=1
DEMO_ENABLE_APPLE_PAY=1
DEMO_ENABLE_PAY_PAL=1

# The domain Apple Pay merchant validation runs against; must be registered on
# the vendor in MyOpayo (Settings > Pay Methods > Apple Pay). Defaults to the
# host the demo is served from, so on 127.0.0.1 Apple Pay shows "6118 Domain
# not registered" until this points at a real registered domain.
OPAYO_APPLE_PAY_DOMAIN=
